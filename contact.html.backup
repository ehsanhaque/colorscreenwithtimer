<!-- ==================== AD PLACEHOLDER - HEADER BANNER ==================== -->
<div style="text-align: center; margin: 1rem auto; max-width: 728px; display: block;">
<div style="background: #f3f4f6; border: 2px dashed #d1d5db; padding: 2rem; border-radius: 0.5rem; color: #6b7280;">
      AD PLACEHOLDER - Header Banner (728x90)
    </div>
</div>
<!-- ==================== MAIN CONTENT WITH SIDEBAR ADS ==================== -->
<div class="container-with-ads">
<!-- ==================== LEFT SIDEBAR AD ==================== -->
<aside class="sidebar-ad" style="visibility: visible;">
<div style="background: #f3f4f6; border: 2px dashed #d1d5db; padding: 1rem; border-radius: 0.5rem; color: #6b7280; width: 160px; height: 600px; display: flex; align-items: center; justify-content: center; text-align: center; font-size: 0.75rem;">
        AD<br/>PLACEHOLDER<br/><br/>Skyscraper<br/>(160x600)
      </div>
</aside>
<!-- ==================== MAIN CONTENT ==================== -->
<main class="main-content-narrow">
<div class="content-container">
<div class="content-card">
<h2>Contact Us</h2>
<p>
            Have a question, suggestion, or feedback? We'd love to hear from you! Fill out the form below and we'll get back to you as soon as possible.
          </p>
<form class="contact-form" id="contactForm">
<div class="form-group">
<label for="email">Email <span class="required">*</span></label>
<input id="email" name="email" placeholder="your.email@example.com" required="" type="email"/>
</div>
<div class="form-group">
<label for="message">Message <span class="required">*</span></label>
<textarea id="message" name="message" placeholder="Your message here..." required=""></textarea>
</div>
<!-- Google reCAPTCHA -->
<div class="recaptcha-container">
<div class="g-recaptcha" data-sitekey="YOUR_RECAPTCHA_SITE_KEY"></div>
</div>
<button class="submit-btn" type="submit">Send Message</button>
<div class="success-message" id="successMessage">
              Thank you for your message! We'll get back to you soon.
            </div>
<div class="error-message" id="errorMessage">
              Oops! Something went wrong. Please try again.
            </div>
</form>
</div>
</div>
</main>
<!-- ==================== RIGHT SIDEBAR AD ==================== -->
<aside class="sidebar-ad" style="visibility: visible;">
<div style="background: #f3f4f6; border: 2px dashed #d1d5db; padding: 1rem; border-radius: 0.5rem; color: #6b7280; width: 160px; height: 600px; display: flex; align-items: center; justify-content: center; text-align: center; font-size: 0.75rem;">
        AD<br/>PLACEHOLDER<br/><br/>Skyscraper<br/>(160x600)
      </div>
</aside>
</div>
<!-- ==================== BOTTOM AD SECTION ==================== -->
<div style="max-width: 1400px; margin: 2rem auto; padding: 0 var(--space-lg); display: flex; flex-direction: column; align-items: center; gap: 1.5rem;">
<!-- Leaderboard Ad (728x90) -->
<div style="text-align: center;">
<div style="background: #f3f4f6; border: 2px dashed #d1d5db; padding: 1rem; border-radius: 0.5rem; color: #6b7280; width: 728px; height: 90px; display: inline-flex; align-items: center; justify-content: center; text-align: center; font-size: 0.875rem; max-width: 100%;">
        AD PLACEHOLDER - Leaderboard (728x90)
      </div>
</div>
<!-- Two Medium Rectangle Ads Side by Side (300x250 each) -->
<div style="display: flex; gap: 1.5rem; flex-wrap: wrap; justify-content: center;">
<!-- Left Ad -->
<div>
<div style="background: #f3f4f6; border: 2px dashed #d1d5db; padding: 1rem; border-radius: 0.5rem; color: #6b7280; width: 300px; height: 250px; display: flex; align-items: center; justify-content: center; text-align: center; font-size: 0.875rem;">
          AD PLACEHOLDER<br/>Medium Rectangle<br/>(300x250)
        </div>
</div>
<!-- Right Ad -->
<div>
<div style="background: #f3f4f6; border: 2px dashed #d1d5db; padding: 1rem; border-radius: 0.5rem; color: #6b7280; width: 300px; height: 250px; display: flex; align-items: center; justify-content: center; text-align: center; font-size: 0.875rem;">
          AD PLACEHOLDER<br/>Medium Rectangle<br/>(300x250)
        </div>
</div>
</div>
</div>
<footer style="text-align: center; padding: 3rem 1rem 2rem; color: var(--color-gray-600); font-size: 0.875rem;">
<div class="eyebrow">colorscreenwithtimer.com</div>
<p style="margin-bottom: 0.5rem;">
      © 2025 <strong>Color Screen with Timer</strong>. Free to use for focus, lighting, photography, and more.
    </p>
<p style="color: var(--color-gray-500);">
      Built with modern web technologies. No registration required. Works offline.
    </p>
</footer>
<script src="/src/global.js?v=6"></script>
<script>
    // Contact form handling
    document.getElementById('contactForm').addEventListener('submit', function(e) {
      e.preventDefault();

      const form = this;
      const submitBtn = form.querySelector('.submit-btn');
      const successMsg = document.getElementById('successMessage');
      const errorMsg = document.getElementById('errorMessage');

      // Verify reCAPTCHA
      const recaptchaResponse = grecaptcha.getResponse();
      if (!recaptchaResponse) {
        errorMsg.textContent = 'Please complete the reCAPTCHA verification.';
        errorMsg.classList.add('show');
        setTimeout(() => errorMsg.classList.remove('show'), 5000);
        return;
      }

      // Disable submit button
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';

      // Hide previous messages
      successMsg.classList.remove('show');
      errorMsg.classList.remove('show');

      // Collect form data
      const formData = {
        email: document.getElementById('email').value,
        message: document.getElementById('message').value,
        'g-recaptcha-response': recaptchaResponse
      };

      // TODO: Replace with your actual form submission endpoint
      // This is a placeholder - you'll need to set up a backend endpoint
      // Example: fetch('/api/contact', { method: 'POST', body: JSON.stringify(formData) })

      // Simulated submission (replace with actual API call)
      setTimeout(() => {
        // Success simulation
        successMsg.classList.add('show');
        form.reset();
        grecaptcha.reset();
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Message';

        // Hide success message after 10 seconds
        setTimeout(() => successMsg.classList.remove('show'), 10000);

        // For actual implementation, handle errors:
        // .catch(error => {
        //   errorMsg.textContent = 'Failed to send message. Please try again.';
        //   errorMsg.classList.add('show');
        //   submitBtn.disabled = false;
        //   submitBtn.textContent = 'Send Message';
        // });
      }, 1500);
    });
  </script>
<!-- ==================== COOKIE CONSENT ==================== -->
<!-- Floating Cookie Icon -->
<div class="cookie-float-icon" id="cookieFloatIcon" style="display: none;">
<button class="cookie-icon-button" onclick="CookieManager.showBanner()" title="Cookie Settings">
<svg viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8 0-.29.02-.58.05-.86 2.36-1.05 4.23-2.98 5.21-5.37C11.07 8.33 14.05 10 17.42 10c.78 0 1.53-.09 2.25-.26.21.71.33 1.47.33 2.26 0 4.41-3.59 8-8 8z"></path>
<circle cx="8.5" cy="9.5" r="1.5"></circle>
<circle cx="15" cy="9" r="1"></circle>
<circle cx="11" cy="12" r="1"></circle>
<circle cx="16" cy="14" r="1.5"></circle>
</svg>
</button>
</div>
<!-- Cookie Consent Banner -->
<div class="cookie-banner" id="cookie-banner">
<div class="cookie-banner-header">
<div class="cookie-banner-icon">
<svg viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8 0-.29.02-.58.05-.86 2.36-1.05 4.23-2.98 5.21-5.37C11.07 8.33 14.05 10 17.42 10c.78 0 1.53-.09 2.25-.26.21.71.33 1.47.33 2.26 0 4.41-3.59 8-8 8z"></path>
<circle cx="8.5" cy="9.5" r="1.5"></circle>
<circle cx="15" cy="9" r="1"></circle>
<circle cx="11" cy="12" r="1"></circle>
<circle cx="16" cy="14" r="1.5"></circle>
</svg>
</div>
<h3 class="cookie-banner-title">We use cookies</h3>
</div>
<p class="cookie-banner-text">
      We use essential cookies to remember your preferences and optional cookies for analytics and advertising.
      <a href="/cookie-preferences.html">Learn more</a>
</p>
<div class="cookie-banner-actions">
<button class="cookie-btn cookie-btn-reject" onclick="handleCookieReject()">Reject</button>
<button class="cookie-btn cookie-btn-customize" onclick="window.location.href='/cookie-preferences.html'">Customize</button>
<button class="cookie-btn cookie-btn-accept" onclick="handleCookieAccept()">Accept</button>
</div>
</div>
<!-- Cookie Manager Script -->
<script src="/src/cookie-manager.js?v=1"></script>
<script src="/src/preference-tracker.js?v=6"></script>
<script>
    function handleCookieAccept() {
      CookieManager.setConsent({
        essential: true,
        analytics: true,
        advertising: true
      });
      CookieManager.hideBanner();
      showCookieIcon();
    }

    function handleCookieReject() {
      CookieManager.setConsent({
        essential: true,
        analytics: false,
        advertising: false
      });
      CookieManager.hideBanner();
      showCookieIcon();
    }

    function showCookieIcon() {
      document.getElementById('cookieFloatIcon').style.display = 'block';
    }

    // Show cookie icon if consent has already been given
    window.addEventListener('DOMContentLoaded', function() {
      if (CookieManager.hasConsent()) {
        showCookieIcon();
      }
    });
  </script>
</body>
</html>
